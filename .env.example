# ============================================================
# Vitruvian Audio Agent — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Ollama (LLM local) ---
# URL da API do Ollama rodando localmente
OLLAMA_BASE_URL=http://localhost:11434
# Modelo a ser usado (ex: llama3, mistral, gemma2)
OLLAMA_MODEL=llama3

# --- Piper TTS (síntese de voz local) ---
# Caminho absoluto para o executável do Piper
PIPER_EXECUTABLE=piper
# Caminhos para os arquivos de modelo .onnx de cada host
# Baixe modelos em: https://github.com/rhasspy/piper/releases
PIPER_MODEL_HOST1=models/pt_BR-faber-medium.onnx
PIPER_MODEL_HOST2=models/pt_BR-edresson-low.onnx

# --- Output ---
# Caminho do arquivo de saída do podcast
OUTPUT_PATH=podcast.mp3

# ============================================================
# Fase 3 (API providers — preencha quando necessário)
# ============================================================

# --- Provider selection ---
# Defina qual provider usar. Padrão: ollama / piper (local).
# LLM_PROVIDER: ollama | groq | openai
LLM_PROVIDER=ollama
# TTS_PROVIDER: piper | elevenlabs
TTS_PROVIDER=piper

# --- Groq ---
GROQ_API_KEY=
# Modelos disponíveis: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama3-8b-8192

# --- OpenAI ---
OPENAI_API_KEY=
# Modelos disponíveis: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HOST1=
ELEVENLABS_VOICE_HOST2=
# Modelos disponíveis: eleven_turbo_v2, eleven_multilingual_v2
ELEVENLABS_MODEL=eleven_turbo_v2
